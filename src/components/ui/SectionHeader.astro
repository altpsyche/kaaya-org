---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8">
  <span class="block h-1 w-10 rounded-full bg-(--color-primary)" aria-hidden="true"></span>
  <h2 class="mt-3 text-2xl font-bold text-(--color-text) sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-2 text-(--color-text-muted)">{subtitle}</p>}
</div>
