---
import { asset } from '../../lib/links';
import { derivativeAt } from '../../lib/derivatives';

interface Props {
  heading: string;
  subheading?: string;
  cta?: { label: string; href: string };
  image?: string;
  /** Homepage scale: build doc §8 gives the hero 50-70% of the viewport. */
  prominent?: boolean;
}

const { heading, subheading, cta, image, prominent = false } = Astro.props;

/**
 * The hero paints a CSS `background-image`, which can carry no `srcset`, so the
 * two widths are handed to a scoped rule as custom properties and a media query
 * picks between them (decision 20). `derivativeAt()` returns the original when
 * the pass has produced nothing, so both properties collapse to today's single
 * full-size image rather than to a broken URL.
 */
const narrow = image ? derivativeAt(image, 960) : undefined;
const wide = image ? derivativeAt(image, 1920) : undefined;
---

<section
  class:list={[
    'relative flex items-center px-6 py-20',
    prominent ? 'min-h-[60vh]' : 'min-h-[400px]',
    image
      ? 'hero-image bg-cover bg-center'
      : 'bg-gradient-to-br from-(--color-primary) via-(--color-earth) to-(--color-accent)',
  ]}
  style={image ? `--hero-narrow: url('${asset(narrow!)}'); --hero-wide: url('${asset(wide!)}')` : undefined}
>
  {image && <div class="absolute inset-0 bg-(--color-hero-overlay)" />}
  <div class="relative mx-auto max-w-4xl">
    <h1 class="text-4xl font-bold text-(--color-on-hero) sm:text-5xl lg:text-6xl">{heading}</h1>
    {subheading && <p class="mt-4 text-lg text-(--color-on-hero)/85 sm:text-xl">{subheading}</p>}
    {cta && (
      <a
        href={cta.href}
        class="mt-8 inline-block rounded-(--radius-card) bg-(--color-on-hero) px-6 py-3 text-sm font-semibold text-(--color-primary) shadow-sm transition-opacity hover:opacity-90"
      >
        {cta.label}
      </a>
    )}
  </div>
</section>

<style>
  /* The image is set here rather than inline: an inline `background-image`
     would outrank the media query and pin every viewport to one width. */
  .hero-image {
    background-image: var(--hero-narrow);
  }

  @media (min-width: 768px) {
    .hero-image {
      background-image: var(--hero-wide);
    }
  }
</style>
