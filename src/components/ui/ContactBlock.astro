---
import { SITE } from '../../data/site';
import { SECTION_ADDRESS, type Section } from '../../data/inboxes';
import { SECTIONS } from '../../lib/links';

/**
 * The one component that prints an email address (TDD §14). Which address
 * depends on the host: `gallery@` on the gallery, `info@` on place, `connect@`
 * on community, `art@` on home, events and happenings.
 *
 * The section is derived from the path by default, the same derivation the
 * Header and SEO use, so a page cannot forget to say where it lives and quietly
 * print the wrong inbox. `section` overrides it where a page is embedded
 * somewhere its own path does not describe.
 */
interface Props {
  section?: Section;
}

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const first = path.split('/')[1] ?? '';
const derived = first === 'blog' ? 'happenings' : SECTIONS.includes(first) ? first : 'home';

const email = SECTION_ADDRESS[Astro.props.section ?? (derived as Section)];
---

<address class="not-italic space-y-2 text-sm text-(--color-text-muted)">
  <p class="font-semibold text-(--color-text)">{SITE.title}</p>
  <p>{SITE.address}</p>
  <p>
    <a href={`mailto:${email}`} class="hover:text-(--color-primary) transition-colors">{email}</a>
  </p>
  <p>
    {SITE.phone.map((p, i) => (
      <>
        <a href={`tel:${p}`} class="hover:text-(--color-primary) transition-colors">{p}</a>
        {i < SITE.phone.length - 1 && <span> · </span>}
      </>
    ))}
  </p>
</address>
