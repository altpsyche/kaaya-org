---
import { SITE } from '../../data/site';
import { link, asset, SECTIONS } from '../../lib/links';
import ThemeToggle from './ThemeToggle.astro';

/**
 * One Header for six hosts (TDD §5). Row 1 is the cross-site nav and renders
 * everywhere; row 2 is the current section's own nav and is absent on three
 * hosts. Which section is current comes from the path, never from an href —
 * in a production build `link()` returns an absolute cross-subdomain URL, so
 * comparing a path against one marks nothing active.
 */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const first = path.split('/')[1] ?? '';
const section = first === 'blog' ? 'happenings' : SECTIONS.includes(first) ? first : 'home';

// Gallery first and emphasised per build doc §8. Five is the ceiling — §5.
const row1 = [
  { label: 'Art Gallery', section: 'gallery', path: '/gallery', lead: true },
  { label: 'Place', section: 'place', path: '/place' },
  { label: 'Community', section: 'community', path: '/community' },
  { label: 'Events', section: 'events', path: '/events' },
  { label: 'Happenings', section: 'happenings', path: '/blog' },
];

/**
 * Row 2 per §5's table. `home`, `events` and `happenings` have none: the
 * homepage nav stays thin (build doc §1), events is one page whose categories
 * are filters rather than routes, and happenings is one destination. Gallery
 * carries no Art entry — decision 15 merged it into the gallery home.
 */
const row2 = {
  gallery: [
    { label: 'Shop', path: '/gallery/shop' },
    { label: 'Artist', path: '/gallery/artist' },
  ],
  place: [
    { label: 'Story', path: '/place/story' },
    { label: 'Activities', path: '/place/activities' },
    { label: 'Stay', path: '/place/stay' },
    { label: 'Booking', path: '/place/booking' },
  ],
  community: [
    { label: 'Learn', path: '/community/learn' },
    { label: 'Incubate', path: '/community/incubate' },
    { label: 'Exchange', path: '/community/exchange' },
  ],
};

const sub = row2[section] ?? [];

const itemClass = (active: boolean, lead = false) => [
  'block whitespace-nowrap rounded px-3 py-2 transition-colors',
  lead ? 'font-semibold' : 'font-medium',
  active
    ? 'text-(--color-primary) bg-(--color-surface)'
    : 'text-(--color-text-muted) hover:text-(--color-text)',
];
---

<header
  id="site-header"
  class="border-b border-(--color-border) bg-(--color-bg)/90 backdrop-blur sticky top-0 z-20"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 gap-4">
    {section === 'gallery' ? (
      <a href={link('/')} class="shrink-0">
        <img src={asset('/kaaya-art-gallery-logo.png')} alt="Kaaya Art Gallery" class="h-8 w-auto" />
      </a>
    ) : (
      <a href={link('/')} class="shrink-0">
        <img src={asset('/kaaya-logo.png')} alt={SITE.title} class="h-8 w-auto" />
      </a>
    )}

    <div class="flex items-center gap-2">
      {/* Row 1 — hidden on mobile, shown from md up */}
      <ul class="hidden md:flex items-center gap-1 text-sm">
        {row1.map(({ label, section: s, path: p, lead }) => (
          <li>
            <a
              href={link(p)}
              aria-current={section === s ? 'page' : undefined}
              class:list={itemClass(section === s, lead)}
            >{label}</a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      {/* Hamburger — shown on mobile, hidden from md up */}
      <button
        type="button"
        id="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-(--color-border) text-(--color-text-muted) transition-colors hover:border-(--color-primary) hover:text-(--color-primary) md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>

  {sub.length > 0 && (
    <nav
      aria-label={`${section} section`}
      class="hidden md:block border-t border-(--color-border)"
    >
      <ul class="mx-auto flex max-w-5xl items-center gap-1 px-6 py-2 text-sm">
        {sub.map(({ label, path: p }) => (
          <li>
            <a
              href={link(p)}
              aria-current={path === p ? 'page' : undefined}
              class:list={itemClass(path === p)}
            >{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {/* Mobile menu — collapsed by default, toggled open; always hidden from md up.
      Both rows live here, since the section nav has nowhere else to go. */}
  <div id="mobile-nav" hidden class="md:hidden border-t border-(--color-border) px-6 py-3">
    <ul class="flex flex-col gap-1 text-sm">
      {row1.map(({ label, section: s, path: p, lead }) => (
        <li>
          <a
            href={link(p)}
            aria-current={section === s ? 'page' : undefined}
            class:list={itemClass(section === s, lead)}
          >{label}</a>
        </li>
      ))}
    </ul>
    {sub.length > 0 && (
      <ul class="mt-2 flex flex-col gap-1 border-t border-(--color-border) pt-2 text-sm">
        {sub.map(({ label, path: p }) => (
          <li>
            <a
              href={link(p)}
              aria-current={path === p ? 'page' : undefined}
              class:list={itemClass(path === p)}
            >{label}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = menu.hasAttribute('hidden');
    if (open) {
      menu.removeAttribute('hidden');
    } else {
      menu.setAttribute('hidden', '');
    }
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Collapse the mobile menu if the viewport grows past the md breakpoint.
  const mq = window.matchMedia('(min-width: 768px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>
