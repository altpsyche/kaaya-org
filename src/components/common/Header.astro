---
import { SITE } from '../../data/site';
import { url } from '../../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Place', href: url('/place') },
  { label: 'Learn', href: url('/community/learn') },
  { label: 'Incubate', href: url('/community/incubate') },
  { label: 'Exchange', href: url('/community/exchange') },
  { label: 'Blog', href: url('/blog') },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const linkClass = (href: string) => {
  const isActive = pathname === href || (href !== '/' && pathname.startsWith(href));
  return [
    'block whitespace-nowrap rounded px-3 py-2 font-medium transition-colors',
    isActive
      ? 'text-(--color-primary) bg-(--color-surface)'
      : 'text-(--color-text-muted) hover:text-(--color-text)',
  ];
};
---

<header
  id="site-header"
  class="border-b border-(--color-border) bg-(--color-bg)/90 backdrop-blur sticky top-0 z-20"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 gap-4">
    <a href={url('/')} class="text-base font-bold text-(--color-primary) shrink-0">{SITE.title}</a>

    <div class="flex items-center gap-2">
      {/* Inline nav — hidden on mobile, shown from md up */}
      <ul class="hidden md:flex items-center gap-1 text-sm">
        {nav.map(({ label, href }) => (
          <li>
            <a href={href} class:list={linkClass(href)}>{label}</a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      {/* Hamburger — shown on mobile, hidden from md up */}
      <button
        type="button"
        id="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-(--color-border) text-(--color-text-muted) transition-colors hover:border-(--color-primary) hover:text-(--color-primary) md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>

  {/* Mobile menu — collapsed by default, toggled open; always hidden from md up */}
  <div id="mobile-nav" hidden class="md:hidden border-t border-(--color-border) px-6 py-3">
    <ul class="flex flex-col gap-1 text-sm">
      {nav.map(({ label, href }) => (
        <li>
          <a href={href} class:list={linkClass(href)}>{label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = menu.hasAttribute('hidden');
    if (open) {
      menu.removeAttribute('hidden');
    } else {
      menu.setAttribute('hidden', '');
    }
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Collapse the mobile menu if the viewport grows past the md breakpoint.
  const mq = window.matchMedia('(min-width: 768px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>
