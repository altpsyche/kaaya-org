---
import { SITE } from '../../data/site';
import { toCanonical, sectionFor } from '../../lib/links';
import { SECTION_DESCRIPTION } from '../../data/descriptions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

// Decision 6: the default description is the one belonging to the host that
// serves this page, not one global string. A page passing its own still wins.
const {
  title,
  description = SECTION_DESCRIPTION[sectionFor(Astro.url.pathname)],
  // KAAYA-PROXY(T3.1): typographic placeholder from T0.3, standing in for real
  // share imagery. Free of all four banned phrases, so it is safe on every host.
  image = '/og-default.png',
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
// toCanonical(), never link(): a canonical must name the host that serves the
// page, and resolving the path against SITE.url named the apex for all six —
// the URLs the middleware 301s away from. TDD §9 has the table.
const canonical = toCanonical(Astro.url.pathname);
const ogImage = new URL(image, SITE.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{/* A noindex page names no canonical. 404.astro is the only one, and it is
    served for URLs that by definition do not exist — its canonical pointed at
    /404/, which the build does not emit. */}
{!noIndex && <link rel="canonical" href={canonical} />}
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{!noIndex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
