---
import { SITE } from '../../data/site';
import ContactBlock from '../ui/ContactBlock.astro';
import { link } from '../../lib/links';

const year = new Date().getFullYear();

/**
 * The six hosts, and nothing below them (TDD §5). The footer is identical
 * everywhere, so it carries no section nav and no active state — Learn,
 * Incubate and Exchange used to sit here, which made the footer read as
 * Community's own nav on the five hosts that are not Community.
 */
const crossSite = [
  { label: 'Kaaya', path: '/' },
  { label: 'Gallery', path: '/gallery' },
  { label: 'Place', path: '/place' },
  { label: 'Community', path: '/community' },
  { label: 'Events', path: '/events' },
  { label: 'Happenings', path: '/blog' },
];
---

<footer class="border-t border-(--color-border) bg-(--color-surface) mt-auto">
  <div class="mx-auto max-w-5xl px-6 py-10">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <ContactBlock />
      </div>
      <div class="flex flex-col justify-between sm:items-end">
        <nav aria-label="Kaaya sites" class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-(--color-text-muted) sm:justify-end">
          {crossSite.map(({ label, path }) => (
            <a href={link(path)} class="hover:text-(--color-primary) transition-colors">{label}</a>
          ))}
        </nav>
        <p class="mt-6 text-xs text-(--color-text-muted)">
          &copy; {year} {SITE.managedBy}. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
