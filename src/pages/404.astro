---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" noIndex>
  <div class="mx-auto max-w-4xl px-6 py-32 text-center">
    <p class="text-6xl font-bold text-(--color-border)">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-(--color-text)">Page not found</h1>
    <p class="mt-2 text-(--color-text-muted)">The page you're looking for doesn't exist.</p>
    <a href={url('/')} class="mt-8 inline-block text-sm font-medium text-(--color-primary) hover:underline">
      ← Back home
    </a>
  </div>
</Base>
