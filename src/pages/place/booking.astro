---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import Hero from '../../components/ui/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ContactBlock from '../../components/ui/ContactBlock.astro';
import EnquiryForm from '../../components/ui/EnquiryForm.astro';
import { link } from '../../lib/links';

const pageData = await getEntry('pages', 'place-booking');
const {
  heroImage, heroHeading, heroSubheading,
  introParagraphs,
  bookingNote,
} = pageData?.data ?? {};

/* Room types come from the Stay table rather than a second list here: an
   enquiry naming a room that no longer exists is worse than no room field at
   all, and the two would drift the first time accommodation changed. */
const stayData = await getEntry('pages', 'place-stay');
const roomTypes = (stayData?.data?.accommodation ?? []).map((room) => room.type);

const introPs = introParagraphs ?? [
  'Tell us who is coming, when, and what you hope to do while you are here. We will come back to you with what the campus can hold on those dates.',
];
---

<Base
  title="Booking | Kaaya Learning Centre"
  description="Arrange a stay at Kaaya Learning Centre in Tilwari, Dehradun."
>
  <Hero
    heading={heroHeading ?? 'Booking'}
    subheading={heroSubheading ?? 'How to arrange a stay'}
    image={heroImage ?? undefined}
  />

  <div class="mx-auto max-w-5xl px-6 py-16 space-y-16">

    <section>
      <div class="max-w-2xl space-y-4 leading-relaxed text-(--color-text-muted)">
        {introPs.map((p) => <p>{p}</p>)}
      </div>
      <p class="mt-6 max-w-2xl text-sm text-(--color-text-muted)">
        {bookingNote ?? 'An advance of 50% is required on booking confirmation.'}
        {' '}Rates and room types are on
        <a href={link('/place/stay')} class="font-medium text-(--color-primary) hover:underline underline-offset-2">Stay</a>.
      </p>
    </section>

    <section>
      <SectionHeader
        title="Enquire about a stay"
        subtitle="Dates, party size and room type, so we can answer with what the campus can hold."
      />
      {/* Structured fields, not free text (T4.4): a date input submits
          YYYY-MM-DD, so arrival dates arrive comparable rather than as
          "next weekend", and room type is a select over the Stay table. */}
      <EnquiryForm
        subject="Booking Enquiry"
        enquiry="booking"
        inbox="info"
        submitLabel="Send enquiry"
        fields={[
          { name: 'name', label: 'Name', required: true },
          { name: 'email', label: 'Email', type: 'email', required: true },
          { name: 'phone', label: 'Phone', type: 'tel' },
          { name: 'arrival', label: 'Arrival date', type: 'date', required: true },
          { name: 'nights', label: 'Nights', type: 'number', min: 1, required: true },
          { name: 'guests', label: 'Guests', type: 'number', min: 1, required: true },
          {
            name: 'roomType',
            label: 'Room type',
            type: 'select',
            options: [...roomTypes, 'Not sure yet'],
            required: true,
          },
          {
            name: 'purpose',
            label: 'What brings you to Kaaya?',
            type: 'textarea',
            rows: 4,
            placeholder: 'A retreat, a workshop, a family visit — whatever is useful for us to know.',
          },
        ]}
      />
    </section>

    <section>
      <SectionHeader title="Or reach us directly" />
      <ContactBlock />
    </section>

  </div>
</Base>
