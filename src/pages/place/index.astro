---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import Hero from '../../components/ui/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import QuoteBlock from '../../components/ui/QuoteBlock.astro';
import { link } from '../../lib/links';
import { SITE } from '../../data/site';

const mapQuery = encodeURIComponent(`${SITE.title}, ${SITE.address}`);

const pageData = await getEntry('pages', 'place');
const {
  heroImage, heroHeading, heroSubheading,
  locationParagraphs: cmsLocationParagraphs,
  locationQuote: cmsLocationQuote,
  neighbourhoods: cmsNeighbourhoods,
} = pageData?.data ?? {};

const locationParagraphs = cmsLocationParagraphs ?? [
  "Kaaya sits in Tilwari, a village in Sahaspur Block of Dehradun district, at the feet of Bhadraj Valley folded into the foothills of the Mussoorie range. It's a landscape of contrasts: steep, forested slopes rising toward the Bhadraj temple at over 8,000 feet giving way to terraced fields and modest homesteads below, with nearly two-thirds of the watershed under reserve forest cover. All nine villages of the cluster sit on the main road network, and the upcoming Delhi–Dehradun Expressway is expected to bring the region within roughly 2.5 hours of Delhi.",
  'Kaaya\'s own campus spans about an acre on the edge of that reserve forest, with a perennial stream running alongside it. The campus is embedded in nature and reflects a deliberate commitment to sustainable architecture and community integration. The campus is organised into three interconnected sections: a cafeteria and shop offering locally sourced goods, a gallery and eight independent eco-cottages built with mud, bamboo, stone, and wood — a working example of sustainable, traditional construction rather than a stylistic gesture.',
  'Beyond these, the campus houses specialised spaces for creative and learning work: art and pottery studios, a wood workshop, an amphitheatre, and a small nursery, all built using traditional techniques adapted to modern educational use.',
];

const locationQuote = cmsLocationQuote ?? {
  quote: 'Set amid lush green and earthen tones, the campus functions as much as a peaceful eco-retreat setting as a working centre. As we say, here, the space itself is a facilitator',
};

const neighbourhoods = cmsNeighbourhoods ?? [
  {
    title: 'Kitchen Gardens — Neighbours as organic growers',
    body: 'Tilwari village sits in the Doon Valley, a landscape under real pressure. Around 65% of households in the area are classified as Below Poverty Line or Antyodaya. Farming has become increasingly unviable. Young people leave.\n\nWe believe bridging the urban-rural gap can tap into energy, creativity, and possibility on both sides. Kaaya does not pretend to have solved these problems — but we are trying, carefully and incrementally, to show a different way of being in this place.',
  },
  {
    title: "Farmer's Market — An upcoming initiative at Kaaya",
    quote: 'A household walks to the town market, buys tomatoes, dal, dairy, a packet of seeds — and the cash that could have stayed in the neighbourhood disappears into a distant supply chain',
  },
];

// Place's own sub-routes (TDD decision 3). Mirrors the section nav that T2.5's
// Header will carry, so the section home is navigable before that lands.
const sections = [
  { label: 'The origin', href: '/place/story', blurb: 'How Kaaya began, and how it was built' },
  { label: 'Activities', href: '/place/activities', blurb: 'Pottery, workshop, trails, nature art, farm picnics' },
  { label: 'Stay', href: '/place/stay', blurb: 'Rooms, rates, meal plans and campus facilities' },
  { label: 'Booking', href: '/place/booking', blurb: 'Arrange a stay' },
];
---

<Base
  title="Place | Kaaya Learning Centre"
  description="The Kaaya campus in Tilwari, Dehradun — mud architecture, a rural setting, embedded in nature."
>
  <Hero
    heading={heroHeading ?? 'Place'}
    subheading={heroSubheading ?? 'Mud architecture, a rural setting, embedded in nature'}
    image={heroImage ?? undefined}
  />

  <div class="mx-auto max-w-5xl px-6 py-16 space-y-16">

    <section>
      <div class="max-w-3xl space-y-4 leading-relaxed text-(--color-text-muted)">
        {locationParagraphs.map((p) => <p>{p}</p>)}
      </div>
      {locationQuote && (
        <QuoteBlock quote={locationQuote.quote} attribution={locationQuote.attribution} />
      )}
    </section>

    <section>
      <SectionHeader title="What is here" />
      <ul class="grid gap-4 sm:grid-cols-2">
        {sections.map((s) => (
          <li>
            <a
              href={link(s.href)}
              class="group block rounded-(--radius-card) border border-(--color-border) bg-(--color-surface) p-6 transition-all hover:border-(--color-primary) hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-(--color-text) transition-colors group-hover:text-(--color-primary)">{s.label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{s.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <SectionHeader title="The Neighbourhoods" subtitle="Latest updates" />
      <div class="grid gap-8 sm:grid-cols-2">
        {neighbourhoods.map((n) => (
          <div class="space-y-3">
            <h3 class="font-semibold text-(--color-text)">{n.title}</h3>
            {n.body?.split(/\n\n+/).filter((p) => p.trim()).map((p) => (
              <p class="text-sm leading-relaxed text-(--color-text-muted)">{p.trim()}</p>
            ))}
            {n.quote && (
              <QuoteBlock quote={n.quote} attribution={n.attribution} />
            )}
            {n.linkLabel && n.linkHref && (
              <a href={link(n.linkHref)} class="text-sm font-medium text-(--color-primary) hover:underline underline-offset-2">
                {n.linkLabel} →
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <section>
      <SectionHeader title="Location" subtitle={SITE.address} />
      <div class="overflow-hidden rounded-(--radius-card) border border-(--color-border)">
        <iframe
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          title="Kaaya Learning Centre on Google Maps"
          width="100%"
          height="400"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
      <a
        href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block text-sm font-medium text-(--color-primary) hover:underline underline-offset-2"
      >
        Get directions →
      </a>
    </section>

  </div>
</Base>
