---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import Hero from '../components/ui/Hero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ContactBlock from '../components/ui/ContactBlock.astro';
import PostList from '../components/ui/PostList.astro';
import Button from '../components/ui/Button.astro';
import { link } from '../lib/links';
import ResponsiveImage from '../components/ui/ResponsiveImage.astro';

/* Build doc §8's scroll order: gallery content is the first thing below the
   hero, and a visitor must pass it before Place or Community are named. Three
   of the five `featured` works, not all five — the catalogue is the gallery
   home's job, and every work carries `featured: true` today, so the flag
   selects nothing here (T7.3). */
const highlights = (await getCollection('works')).filter((w) => w.data.featured).slice(0, 3);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pageData = await getEntry('pages', 'home');
const {
  heroImage, heroHeading, heroSubheading,
  introHeading, introText,
  directionsNote,
  storyParagraphs, storyLinks,
} = pageData?.data ?? {};

/* Build doc §8's teaser, verbatim, duplicated here as the fallback every page
   in this repo carries — clearing the field in the CMS falls through to it, so
   the two must move together. */
const story = storyParagraphs?.length ? storyParagraphs : [
  "Kaaya isn't a gallery built for art alone.",
  'It sits on a campus that has spent years quietly practicing a different way of living — testing what it means to grow food, build shelter, and share resources without taking more than the land can give back.',
  "The art here didn't arrive from elsewhere. It grew out of that same ground — shaped by the people who've lived, worked, and stayed on this land, in exchange with it and with each other.",
  "What you're seeing is one visible layer of something larger.",
];

const storyExits = storyLinks?.length ? storyLinks : [
  { prompt: "See how it's built, and where →", label: 'Know the place', href: '/place' },
  { prompt: 'Understand the wider circle →', label: 'Know the community', href: '/community' },
];
---

{/* No `description`: the homepage takes the apex's own string from
    SECTION_DESCRIPTION (decision 6), so the front door and the shared 404 say
    the same thing and there is one place to change it. The title stays here
    because it is this page's, not the host's — it previously carried
    "sustainable living", one of the four phrases build doc §9 bans from
    kaaya.org and gallery.kaaya.org, so it must stay clear of all four. */}
<Base title="Kaaya — an art space on a working campus">
  <Hero
    heading={heroHeading ?? "It's about Re-imagining"}
    subheading={heroSubheading ?? 'Tilwari, Dehradun · Himalayan Foothills, India'}
    image={heroImage ?? undefined}
    prominent
  />
  {/* No CTA: build doc §8 gives the homepage hero no competing call to action,
      and the nav is the only thing above the fold that leads anywhere.
      `heroImage` still carries the campus photograph the old site used; §8 wants
      the current exhibition, which the Kaaya team owes. Swapping that one YAML
      value is the whole of the remaining change. */}

  {highlights.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 pt-16">
      <SectionHeader
        title="From the gallery"
        subtitle="Original work by emerging artists of the Himalayan region."
      />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {highlights.map((work) => (
          <li class="rounded-(--radius-card) border border-(--color-border) overflow-hidden">
            {work.data.images[0] && (
              <ResponsiveImage
                src={work.data.images[0]}
                alt={work.data.title}
                class="aspect-square w-full object-cover"
              />
            )}
            <div class="p-5">
              {/* The work's own page is /gallery/shop/[slug] (T7.5). Until it
                  exists the card leads to the artist, whose page does. */}
              <h3 class="font-semibold text-(--color-text)">{work.data.title}</h3>
              {work.data.artist && (
                <p class="mt-1 text-sm">
                  <a href={link(`/gallery/artist/${work.data.artist}`)} class="text-(--color-primary) hover:underline underline-offset-2">
                    {work.data.artist.split('-').map((s) => s[0].toUpperCase() + s.slice(1)).join(' ')}
                  </a>
                </p>
              )}
              {work.data.medium && <p class="mt-1 text-sm text-(--color-text-muted)">{work.data.medium}</p>}
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-8">
        <Button href={link('/gallery')} label="See the gallery" variant="ghost" />
      </div>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="max-w-2xl">
      <h2 class="text-xl font-semibold text-(--color-text)">{introHeading ?? 'An art space on a working campus'}</h2>
      <p class="mt-4 leading-relaxed text-(--color-text-muted)">
        {introText ?? 'Kaaya Learning Centre is a mud-built campus in the village of Tilwari where urban and rural communities meet, learn from each other, and find that the exchange is worth making.'}
      </p>
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 pb-20">
      <SectionHeader title="Latest from Kaaya" />
      <PostList posts={recentPosts} />
      <div class="mt-8">
        <Button href={link('/blog')} label="View All Updates" variant="ghost" />
      </div>
    </section>
  )}

  {/* Footer-weight Kaaya Story teaser (build doc §8). Deliberately quiet: it
      sits last before the Visit block, and its two links are the first mention
      of Place and Community anywhere on the page. */}
  <section class="mx-auto max-w-5xl px-6 pb-16">
    <div class="max-w-2xl border-t border-(--color-border) pt-10">
      {story.map((paragraph) => (
        <p class="mt-4 text-sm leading-relaxed text-(--color-text-muted) first:mt-0">{paragraph}</p>
      ))}
      <div class="mt-8 flex flex-col gap-2 text-sm">
        {storyExits.map(({ prompt, label, href }) => (
          <p class="text-(--color-text-muted)">
            <em>{prompt}</em>{' '}
            <a href={link(href)} class="font-semibold text-(--color-primary) hover:underline underline-offset-2">{label}</a>
          </p>
        ))}
      </div>
    </div>
  </section>

  {/* Footer-weight Visit info, folded in from the deleted /visit route (build
      doc §8). The middleware 301s the old /visit URL to this anchor, so the id
      is load-bearing — do not rename it. */}
  <section id="visit" class="border-t border-(--color-border) bg-(--color-surface)">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <SectionHeader title="Visit" subtitle={directionsNote ?? 'We are approximately 20 km from Dehradun city'} />
      <div class="grid gap-8 sm:grid-cols-2">
        <ContactBlock />
        <p class="text-sm leading-relaxed text-(--color-text-muted)">
          Rooms, rates, meal plans and campus facilities are on
          <a href={link('/place/stay')} class="font-medium text-(--color-primary) hover:underline underline-offset-2">Place → Stay</a>,
          and stays are arranged through
          <a href={link('/place/booking')} class="font-medium text-(--color-primary) hover:underline underline-offset-2">Place → Booking</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
