---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import Hero from '../../components/ui/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import QuoteBlock from '../../components/ui/QuoteBlock.astro';
import ProgramTable from '../../components/ui/ProgramTable.astro';
import { url } from '../../lib/url';

const pageData = await getEntry('pages', 'community-learn');
const {
  heroImage, heroHeading, heroSubheading,
  introParagraphs,
  programs: cmsPrograms,
  programsQuote,
} = pageData?.data ?? {};

const programs = cmsPrograms ?? [
  {
    duration: '1–5 days',
    name: 'Short immersions',
    description: 'Curriculum-linked outdoor camps built around the seed journey, the milk journey, and the soil journey. Children work with their hands and return with a different sense of where food comes from.',
  },
  {
    duration: '1–5 weeks',
    name: 'Project residencies',
    description: 'Students narrow in on a specific local challenge and work on it collaboratively alongside the community — not as observers, but as participants in real problem-solving.',
  },
  {
    duration: 'Up to 6 months',
    name: 'Live projects & internships',
    description: 'For college students and young professionals. The aim is not to apply what was learned in classrooms — but to discover what classrooms could not teach.',
  },
  {
    duration: 'Summer',
    name: 'Detox camps',
    description: 'Spaces for urban children to form genuine friendships, explore independently, and simply be in nature for a while. When children arrive from different schools, without existing hierarchies or shared histories, something else becomes possible.',
  },
];

const introPs = introParagraphs ?? [
  'Kaaya is not running courses. It is not in the business of teaching. What happens here is closer to a shared inquiry — and the programmes below are invitations to join it, not enrol in it.',
  'The dairy farmer who leads the milk journey knows what a cow eats, what it costs to keep her, what rate he receives, how purity is tested. He knows this because his livelihood depends on it. When students walk with him, they are not receiving instruction. They are entering a different relationship with knowledge — one the classroom was not designed to provide.',
];
---

<Base
  title="Learn | Kaaya Learning Centre"
  description="Experiential learning programmes at Kaaya — immersions, residencies, internships, and hands-on sessions."
>
  <Hero
    heading={heroHeading ?? 'Learn'}
    subheading={heroSubheading ?? 'Learning alongside, not enrolling in'}
    image={heroImage ?? undefined}
  />

  <div class="mx-auto max-w-5xl px-6 py-16 space-y-16">

    <section>
      <SectionHeader title="Learning alongside" />
      <div class="max-w-2xl space-y-4 text-(--color-text-muted) leading-relaxed">
        {introPs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section>
      <SectionHeader
        title="Experience · Engage · Explore"
        subtitle="Programmes by duration"
      />
      <ProgramTable programs={programs} />
      <QuoteBlock
        quote={programsQuote?.quote ?? "We also value unstructured time. We let children feel bored. Boredom, we have found, is where the roots of imagination lie dormant"}
        attribution={programsQuote?.attribution}
      />
    </section>

    {/* The hands-on sessions themselves are described in full at Place →
        Activities, which is their single canonical source (TDD decision 11).
        Learn keeps the programmes table and links across. */}
    <section>
      <SectionHeader
        title="Hands-on Sessions"
        subtitle="Pottery, the wood workshop, forest and eco trails, nature art classes and farm day picnics all run on the campus itself."
      />
      <p class="max-w-2xl text-sm text-(--color-text-muted)">
        <a href={url('/place/activities')} class="font-medium text-(--color-primary) hover:underline underline-offset-2">
          See what runs on the campus →
        </a>
      </p>
    </section>

  </div>
</Base>
