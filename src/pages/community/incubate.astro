---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import Hero from '../../components/ui/Hero.astro';
import EnquiryForm from '../../components/ui/EnquiryForm.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import QuoteBlock from '../../components/ui/QuoteBlock.astro';
import IncubationCard from '../../components/ui/IncubationCard.astro';

const pageData = await getEntry('pages', 'community-incubate');
const {
  heroImage, heroHeading, heroSubheading,
  introParagraphs,
  stat1Value, stat1Label, stat2Value, stat2Label,
  incubations: cmsIncubations,
  incubationsQuote,
} = pageData?.data ?? {};

const incubations = cmsIncubations ?? [
  {
    name: 'Padav Fellowship',
    by: 'Jagmohan Bangani',
    description: 'Jagmohan Bangani, a visionary artist from Uttarakhand, partnered with Kaaya to establish a mentorship hub for emerging young artists from the remote mountain region. While Jagmohan provided the creative mentorship, artists network, and craft support, Kaaya served as the essential anchor — the \'padav\' — offering its campus, logistical framework, and relaxed natural ambience to transform his dream into a living reality for promoting arts and artists in the region. In the process, the Bangani Art Foundation has been established to continue supporting arts and artists in the Himalayan region.',
  },
  {
    name: 'Anutraaya',
    by: 'Asambhava',
    description: 'Asambhava is an entrepreneur concerned with what happens to knowledge when the conditions that produced it disappear. Anutraaya is the name for this inquiry — where the traditional is not preserved in a museum but practised in a living environment. Using Kaaya and the neighbouring village of Tilwari as the ground for this experiment, the initiative seeks to translate ancestral wisdom into resilient pathways for the future. Step into Anutraaya\'s journey of rethinking food, language and craft so everyday life in the hills can stay rooted and resilient.',
  },
];

const introPs = introParagraphs ?? [
  'Some ideas need more than a desk and a screen. They need a room, a community, a field, a kiln, a kitchen — or simply time and honest ground conditions. At Kaaya, we offer the space for seedling concepts to take root in reality before they face the scale of the marketplace.',
  'Through our Plug \'n\' Play model, we invite innovators to inhabit the campus. Kaaya may provide the physical space, engage in co-creation, or act as an active field partner — testing and refining ideas in a living environment, alongside a community that has its own knowledge and its own pace.',
];
---

<Base
  title="Incubate | Kaaya Learning Centre"
  description="Kaaya's Plug 'n' Play incubation model for seedling ideas — Padav Fellowship and Anutraaya."
>
  <Hero
    heading={heroHeading ?? 'Incubate'}
    subheading={heroSubheading ?? 'A place for ideas that are still becoming'}
    image={heroImage ?? undefined}
  />

  <div class="mx-auto max-w-5xl px-6 py-16 space-y-16">

    <section>
      <SectionHeader title="A place for ideas that are still becoming" />
      <div class="max-w-2xl space-y-4 text-(--color-text-muted) leading-relaxed">
        {introPs.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-8 flex gap-10 text-center">
        <div>
          <p class="text-4xl font-bold text-(--color-primary)">{stat1Value ?? '2'}</p>
          <p class="mt-1 text-sm text-(--color-text-muted)">{stat1Label ?? 'ideas currently being incubated'}</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-(--color-earth)">{stat2Value ?? '∞'}</p>
          <p class="mt-1 text-sm text-(--color-text-muted)">{stat2Label ?? 'ideas this place can hold, if they are the right ones'}</p>
        </div>
      </div>
    </section>

    <section>
      <SectionHeader title="Current Incubations" />
      <div class="grid gap-6 sm:grid-cols-2">
        {incubations.map((item) => (
          <IncubationCard
            name={item.name}
            by={item.by}
            description={item.description}
            links={item.links}
          />
        ))}
      </div>
      <QuoteBlock
        quote={incubationsQuote?.quote ?? "Kaaya does not incubate ideas for you. It incubates them with you — and sometimes, in spite of you, the place itself becomes part of what you are making."}
        attribution={incubationsQuote?.attribution}
      />
    </section>

    <section>
      <SectionHeader
        title="Bring your idea to life at Kaaya"
        subtitle="We are looking for serious, thoughtful concepts that seek more than just a backdrop. Begin with an honest conversation about what you hope to build."
      />
      <EnquiryForm
        subject="Incubate Inquiry"
        enquiry="incubate"
        submitLabel="Share your idea"
        fields={[
          { name: 'name', label: 'Name', required: true },
          { name: 'phone', label: 'Phone', type: 'tel' },
          { name: 'about', label: 'About you in short', type: 'textarea', rows: 3, required: true },
          { name: 'idea', label: 'Your idea brief', type: 'textarea', rows: 5, required: true },
          { name: 'doc', label: 'Your work / doc / video link', type: 'url', placeholder: 'https://' },
        ]}
      />
    </section>

  </div>
</Base>
